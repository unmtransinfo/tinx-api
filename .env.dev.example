# ── Django / API settings ─────────────────────────────────────────────────────
ALLOWED_HOSTS=localhost,127.0.0.1
DEBUG=true

# ── Database credentials ──────────────────────────────────────────────────────
# These are used by both the tinx_db image and the tinx_api service.
# Make sure to modify both _PASSWORD variables
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=tinx
DB_USER=tinx_user
DB_PASSWORD=changeme_user

# ── Database resource limits ──────────────────────────────────────────────────
# Used by docker compose deploy limits and by tune.sh to generate mysql-tuning.cnf.
DB_CPUS=8
DB_MEMORY=128G

# ── Database dump URL ─────────────────────────────────────────────────────────
# The tinx_db image downloads and restores this dump on first boot.
DUMP_URL=https://unmtid-dbs.net/download/TIN-X/tinx-mysql-shell.tar.gz

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=America/Denver

# ── Port mappings (dev only) ──────────────────────────────────────────────────
TINX_UI_HTTP_PORT=8080
TINX_API_PORT=8000