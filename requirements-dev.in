# Development/upgrade tooling -- not installed in the production image.
#
#   pip-compile requirements-dev.in
#   pip-sync requirements.txt requirements-dev.txt

pip-tools

# Auto-rewrites Django source for a target version's idioms (url() ->
# re_path(), etc.) -- run as `django-upgrade --target-version X.Y <files>`
# at each stage of the Django upgrade.
django-upgrade

# General Python syntax modernizer, e.g. stripping dead
# `from __future__ import unicode_literals` imports once Python 2 support
# is no longer a concern.
pyupgrade
