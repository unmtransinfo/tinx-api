# ── Django / API settings ─────────────────────────────────────────────────────
ALLOWED_HOSTS=api.newdrugtargets.org
DEBUG=false

# ── Database credentials ──────────────────────────────────────────────────────
# These are used by both the tinx_db image and the api service.
# Make sure to modify both _PASSWORD variables
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=tinx
DB_USER=tinx_user
DB_PASSWORD=changeme_user

# Do not change DB_PORT, but you can modify DB_HOST_PORT if you would like to access the DB from localhost at this port (port maps DB_HOST_PORT:DB_PORT)
DB_PORT=3306
DB_HOST_PORT=33306

# ── Database resource limits ──────────────────────────────────────────────────
# Used by docker compose deploy limits and by tune.sh to generate mysql-tuning.cnf.
# Adjust these to match the actual host's resources before running ./tune.sh.
DB_CPUS=4
DB_MEMORY=8G

# ── Database dump URL ─────────────────────────────────────────────────────────
# The tinx_db image downloads and restores this dump on first boot.
DUMP_URL=https://unmtid-dbs.net/download/TIN-X/tinx-mysql-shell.tar.gz

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=America/Denver

# ── Port mappings ──────────────────────────────────────────────────────────────
# The API is bound to 127.0.0.1 only — Apache (running on the host, outside this
# repo) reverse-proxies to it. See docs/Apache_Deployment.md.
TINX_API_PORT=8000

# ── UI build ───────────────────────────────────────────────────────────────────
# npm script to run when building the UI (see tinx-ui/package.json)
BUILD_COMMAND=build

# Base URL of the API, baked into the UI build at build time
API_ROOT=https://api.newdrugtargets.org
