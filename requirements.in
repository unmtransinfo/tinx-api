# Top-level runtime dependencies only. Transitive dependencies are locked
# into requirements.txt by pip-compile (from pip-tools) -- do not add them
# here directly.
#
# Regenerate requirements.txt after editing this file:
#   pip-compile requirements.in
#
# To bump a single package (and let pip-compile resolve compatible versions
# of anything it pulls in) rather than re-resolving everything at once:
#   pip-compile --upgrade-package <name>==<version> requirements.in

